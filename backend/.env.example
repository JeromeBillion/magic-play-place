# Comma-separated origins allowed by CORS.
# Use explicit origins in production.
CORS_ORIGINS=http://localhost:3000

# Backend runtime mode:
# - mock: returns simulated outputs (current default)
# - tribe: runs real TribeModel inference in /predict
INFERENCE_MODE=mock

# Upload storage and limits.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
MAX_TEXT_CHARS=8000
UPLOAD_TTL_HOURS=24
UPLOAD_CLEANUP_INTERVAL_SECONDS=900
DELETE_UPLOADS_AFTER_INFERENCE=false
REQUIRE_API_KEY=false
API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
ASYNC_JOB_QUEUE_ENABLED=true
JOB_WORKER_CONCURRENCY=2
JOB_QUEUE_MAX_PENDING=100
JOB_RETENTION_HOURS=24
JOB_CLEANUP_INTERVAL_SECONDS=900
GENERATE_SIMULATION_DELAY_SECONDS=1.5
GENERATE_MODE=simulation
GENERATE_MODEL_LOOP_VALIDATED=false
GENERATE_MODEL_LOOP_VALIDATION_REPORT=
GENERATE_MODEL_LOOP_SIGNED_OFF=false
GENERATE_MODEL_LOOP_SIGNOFF_REPORT=
GENERATE_MODEL_LOOP_ITERATIONS=24
JOB_MAX_RETRIES=2
DLQ_MAX_ITEMS=1000
METRICS_ENABLED=true
METRICS_REQUIRE_API_KEY=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=magic-play-place-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
QUEUE_BACKEND=inmemory
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=mpp
REDIS_WORKER_POLL_SECONDS=2

# TribeModel configuration (required when INFERENCE_MODE=tribe)
TRIBEV2_CHECKPOINT_DIR=
TRIBEV2_CHECKPOINT_NAME=best.ckpt
TRIBEV2_CACHE_FOLDER=cache\tribev2
TRIBEV2_DEVICE=auto
TRIBEV2_CLUSTER=
TRIBEV2_PRELOAD_MODEL=false
