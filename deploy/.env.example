# Copy this file to deploy/.env and replace placeholder values before deployment.

# Frontend build-time public config (baked into Next.js bundle during docker build).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=CHANGE_ME

# Backend security defaults.
CORS_ORIGINS=http://localhost:3000
REQUIRE_API_KEY=true
API_KEY=CHANGE_ME
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# Queue + worker defaults for durable async jobs.
ASYNC_JOB_QUEUE_ENABLED=true
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
JOB_WORKER_CONCURRENCY=2
JOB_QUEUE_MAX_PENDING=200
JOB_MAX_RETRIES=2
DLQ_MAX_ITEMS=1000

# Inference/generation defaults for safe baseline deploy.
INFERENCE_MODE=mock
GENERATE_MODE=simulation
GENERATE_MODEL_LOOP_VALIDATED=false
GENERATE_MODEL_LOOP_SIGNED_OFF=false

# Observability defaults.
METRICS_ENABLED=true
METRICS_REQUIRE_API_KEY=true
OTEL_ENABLED=false
